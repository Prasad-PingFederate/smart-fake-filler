{
  "manifest_version": 3,
  "name": "Smart Fake Filler",
  "version": "1.2.0",
  "description": "Fills forms with fake data that passes real field rules: patterns, length, dosage, SWIFT, IBAN, dates, and more.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Fake Filler"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Fill form with smart fake data"
    }
  }
}
